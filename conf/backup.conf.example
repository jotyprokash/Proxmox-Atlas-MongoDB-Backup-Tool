# MongoDB Atlas Connection String
ATLAS_URI="mongodb+srv://user:pass@cluster.mongodb.net/db"

# Local Storage Path (Recommended: Mount Point to Hardware)
BACKUP_DIR="/var/lib/atlas-backup"

# Data Retention (Days)
RETENTION_DAYS=15

# State tracking (Do not change unless necessary)
STATE_FILE="/var/lib/atlas-backup/checkpoint.json"

# Optional: Discord/Slack Webhook for Alerts
# WEBHOOK_URL="https://discord.com/api/webhooks/..."
